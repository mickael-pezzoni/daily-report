# Variables for a deployment via docker-compose.prod.yml.
# Copy to .env.prod, fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# Database password — used by both the postgres service and the api's
# DATABASE_URL (see docker-compose.prod.yml). Change the demo value below.
POSTGRES_PASSWORD=change-me

# Session signing key. Generic name here — the compose file forwards it to
# BETTER_AUTH_SECRET (see docker-compose.prod.yml), the name expected by the
# auth library; no need to know that name to run the image.
AUTH_SECRET=change-me-in-production-32-chars-min

# Web and API share the same origin in this deployment (the api serves the
# web build): a single public URL, which the compose file forwards to both
# BETTER_AUTH_URL and WEB_URL (see docker-compose.prod.yml) — no need to set
# it twice with the risk of the two drifting apart.
PUBLIC_URL=https://your-domain.example

# ─── Attachment storage ───────────────────────────────────────────────────
# "local" driver by default (compose's `uploads` volume, mounted at
# /app/uploads). For S3/R2/MinIO/Backblaze/Scaleway, see
# apps/api/.env.example for the full list of S3_* variables.
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=26214400
