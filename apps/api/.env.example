DATABASE_URL=postgres://postgres:password@localhost:5432/daily_report
BETTER_AUTH_SECRET=change-me-in-production-32-chars-min
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:5173
PORT=3001

# ─── Stockage des pièces jointes ──────────────────────────────────────────
# « local » (disque, déploiement on-premise) ou « s3 » (S3, R2, MinIO,
# Backblaze, Scaleway… — tout ce qui parle le protocole S3).
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=26214400

# Driver « local »
STORAGE_LOCAL_DIR=./uploads

# Driver « s3 » — obligatoires seulement si STORAGE_DRIVER=s3.
# S3_BUCKET=daily-report
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Laisser S3_ENDPOINT vide pour AWS S3. Sinon :
#   Cloudflare R2  https://<account_id>.r2.cloudflarestorage.com  (region=auto)
#   MinIO          http://localhost:9000  (+ S3_FORCE_PATH_STYLE=true)
# S3_ENDPOINT=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
# Validité des URL de téléchargement signées, en secondes.
# SIGNED_URL_TTL_SECONDS=300
