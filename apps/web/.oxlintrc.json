{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "env": { "browser": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // Transform JSX automatique (jsx: "react-jsx") : React n'a pas à être importé.
    "react/react-in-jsx-scope": "off"
  }
}
